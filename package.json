{
  "name": "feishu-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Mirror Codex and Claude Code sessions to Feishu and continue them from Feishu topics.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "start:container": "node scripts/container-start.mjs",
    "start:claude": "node dist/src/claude/index.js",
    "dev": "tsx src/index.ts",
    "dev:claude": "tsx src/claude/index.ts",
    "doctor": "node scripts/doctor.mjs",
    "doctor:container": "node scripts/doctor.mjs --container",
    "doctor:claude": "node scripts/doctor-claude.mjs",
    "notify:claude": "node dist/src/claude/notify.js",
    "check:cards": "node scripts/check-cards.mjs",
    "install:local": "node scripts/install.mjs",
    "install:claude": "node scripts/install-claude.mjs",
    "rebind": "node scripts/rebind.mjs",
    "uninstall:claude-hooks": "node scripts/uninstall-claude-hooks.mjs",
    "test": "npm run build && node --no-warnings --test dist/test/*.test.js",
    "test:fast": "node --no-warnings --test dist/test/*.test.js",
    "test:journey": "FEISHU_PATCH_INTERVAL_MS=60 FEISHU_REJECTION_RETRY_MS=400 node --no-warnings --import tsx scripts/e2e-user-journey.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@larksuiteoapi/node-sdk": "1.72.0",
    "chokidar": "4.0.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
