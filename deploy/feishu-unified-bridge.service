[Unit]
Description=Feishu Unified Agent Bridge (Claude + Codex + Antigravity)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=NODE_ENV=production
EnvironmentFile=@ENVIRONMENT_FILE@
ExecStart=@NODE_BIN@ @PROJECT_DIR@/scripts/unified-start.mjs --run --config @CONFIG_PATH@
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
