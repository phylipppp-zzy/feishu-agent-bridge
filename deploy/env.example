# The interactive installer writes the real file to:
# ~/.config/feishu-codex-bridge/env
FEISHU_APP_ID="cli_replace_me"
FEISHU_APP_SECRET="replace_me"
FEISHU_BIND_TOKEN="replace_with_a_random_one_time_token"
FEISHU_CARD_UI_VERSION="2"
# Use "manual" with ./install.sh --from-env. The QR installer manages this value itself.
FEISHU_SETUP_VERSION="manual"
ALLOWED_ROOT="/home/replace_me"
CODEX_HOME="/home/replace_me/.codex"
CODEX_BIN="/path/to/codex"
STATE_DIR="/home/replace_me/.local/state/feishu-codex-bridge"
# Default: Feishu Default turns use workspace-write only for the canonical cwd;
# Plan is read-only. Both disable network access.
CODEX_EXECUTION_MODE="workspace-write"
# Optional comma-separated MCP servers that may request user interaction.
CODEX_ALLOWED_MCP_SERVERS=""
# Root is for a dedicated, preflight-checked container only. Do not enable it
# on a host. If explicitly enabled, every Root task still needs a one-time card.
# CODEX_EXECUTION_MODE="root-danger-full-access"
# ROOT_FULL_ACCESS_ACK="I_UNDERSTAND_CODEX_CAN_MODIFY_THE_ENTIRE_CONTAINER"
# ROOT_GRANT_TTL_SECONDS="600"
