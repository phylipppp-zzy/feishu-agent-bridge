# Environment for the Feishu ↔ Claude Code bridge (dist/src/claude/index.js), which mirrors local
# sessions into Feishu and can also continue them from Feishu.
# The interactive installer (./install-claude.sh) writes the real file to:
# ~/.config/feishu-claude-bridge/env   (permissions 600)
# Use a separate Feishu app from the Codex bridge: each long-connection event reaches only one client.
FEISHU_APP_ID="cli_replace_me"
FEISHU_APP_SECRET="replace_me"
FEISHU_BIND_TOKEN="replace_with_a_random_one_time_token"
# Written by the QR installer: the installing user's open_id, used to restrict app visibility.
# FEISHU_OWNER_OPEN_ID="ou_replace_me"
# Use "manual" with ./install-claude.sh --from-env. The QR installer manages this value itself.
FEISHU_SETUP_VERSION="manual"
FEISHU_RUNTIME="systemd"
# Claude Code configuration directory (CLAUDE_CONFIG_DIR if you set one); transcripts are read
# from $CLAUDE_HOME/projects and the session-state hooks live in $CLAUDE_HOME/settings.json.
CLAUDE_HOME="/home/replace_me/.claude"
# The local claude executable that runs sessions continued from Feishu (not the SDK's bundled binary).
CLAUDE_BIN="/path/to/claude"
# Bridge database and the presence/ directory written by scripts/claude-hook.mjs.
STATE_DIR="/home/replace_me/.local/state/feishu-claude-bridge"
# New sessions started from Feishu must work in this directory or a directory below it.
ALLOWED_ROOT="/home/replace_me"
# Sessions active within this many days get a Feishu topic when the bridge first sees them.
HISTORY_DAYS="3"
# Optional: mirror only sessions whose working directory is one of these directories or below them.
# Absolute paths (or ~/...), separated by commas. Empty mirrors every directory.
SYNC_DIRS=""
# Optional: idle ms before the bridge's claude process for a session exits; the next message resumes it.
# RUNNER_IDLE_MS="600000"
# Written by the installer: the PATH of the shell that ran ./install-claude.sh, so commands in sessions
# continued from Feishu find the same programs as in a terminal. Rerun the installer after changing PATH.
# PATH="..."
